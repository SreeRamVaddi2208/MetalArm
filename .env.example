# ---------------------------------------------------------------------------
# LevelForge environment template.
# Copy to .env and replace every placeholder. .env is gitignored - never commit
# real credentials.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Postgres (consumed by both the postgres service and the backend) ---
POSTGRES_USER=levelforge
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=levelforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Host port for psql/GUI access. Container-internal port stays 5432.
# 5434 because a native macOS Postgres owns 5432 on this machine.
POSTGRES_HOST_PORT=5434

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
# Redis refuses to be silent about running unauthenticated. The published port
# is bound to loopback, but a password also stops anything else on this machine
# reading the leaderboard cache.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_48_BYTE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Backend ---
BACKEND_HOST_PORT=8000
LOG_LEVEL=info
# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Reflex) ---
# dev: 3000 = UI, 8001 = Reflex state server (8001 avoids the FastAPI 8000).
# prod/Docker: Reflex REQUIRES both on ONE port, so it serves everything on 3000.
# REFLEX_API_URL is baked into the JS bundle at BUILD time - changing it needs a rebuild.
FRONTEND_HOST_PORT=3000
# Local `reflex run` dev only - unused by Docker (prod is single-port 3000).
REFLEX_BACKEND_HOST_PORT=8001
# Must be reachable from the BROWSER, not just from inside the compose network.
REFLEX_API_URL=http://localhost:3000
# Where Reflex sends LevelForge API calls.
# LOCAL `reflex run` ONLY. Inside Docker, compose sets this to
# http://backend:8000 and deliberately ignores this value: Reflex event
# handlers run server-side, so `localhost` there means the Reflex container
# itself, not the backend.
LEVELFORGE_API_BASE_URL=http://localhost:8000

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@levelforge.dev
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_HOST_PORT=5050
