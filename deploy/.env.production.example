# ---------------------------------------------------------------------------
# MetalArm production environment.
#   cp deploy/.env.production.example deploy/.env.production
# then replace every CHANGE_ME. deploy/.env.production is gitignored - never
# commit it. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# Web app at https://DOMAIN, API at https://api.DOMAIN. Point both DNS names
# (A/AAAA records) at the server before the first start.
DOMAIN=metalarm.example.com
# Let's Encrypt expiry notices.
ACME_EMAIL=CHANGE_ME@example.com
# Shown on the /privacy and /support pages.
SUPPORT_EMAIL=CHANGE_ME@example.com

# --- Postgres ---
POSTGRES_USER=metalarm
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=metalarm

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- Auth ---
# Rotating this signs every user out (all tokens become invalid).
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_48_BYTE_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Runtime ---
# Roughly one per CPU core.
BACKEND_WORKERS=2
LOG_LEVEL=info
BACKUP_RETENTION_DAYS=14
