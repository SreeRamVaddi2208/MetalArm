<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>MetalArm</string>
	<!-- Only standard HTTPS; saves the export-compliance question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Bundled design fonts (SIL Open Font License; see Fonts/OFL-*.txt). -->
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk-Regular.ttf</string>
		<string>SpaceGrotesk-Medium.ttf</string>
		<string>SpaceGrotesk-SemiBold.ttf</string>
		<string>SpaceGrotesk-Bold.ttf</string>
		<string>Manrope-Regular.ttf</string>
		<string>Manrope-Medium.ttf</string>
		<string>Manrope-SemiBold.ttf</string>
		<string>Manrope-Bold.ttf</string>
	</array>
	<!-- Per-configuration server addresses (METALARM_*_BASE_URL build settings), read by AppConfig. -->
	<key>METALARMAPIBaseURL</key>
	<string>$(METALARM_API_BASE_URL)</string>
	<key>METALARMWebBaseURL</key>
	<string>$(METALARM_WEB_BASE_URL)</string>
	<!-- Plain HTTP only to local addresses, for the Debug build's local stack. -->
	<!-- Shown by iOS when the Health permission sheet appears. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>MetalArm adds your finished workouts to Apple Health, so they appear in Fitness alongside everything else you do. It never reads your health data.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
